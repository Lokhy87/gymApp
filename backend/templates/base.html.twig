<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
    {% if is_granted('ROLE_USER') %}
    <nav style="display: flex; gap: 30px; padding: 20px; background-color: #f8f9fa;">
        <a href="{{ path('app_main') }}" style="font-size: 20px; color: blue; text-decoration: none">
            Start
        </a>
        <a href="{{ path('app_api') }}" style="font-size: 20px; color: blue; text-decoration: none">
            Api (ENDPOINTS)
        </a>
        {% endif %}
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_muscle_groups_index') }}" style="font-size: 20px; color: blue; text-decoration: none">
            Muscle Group
        </a>
        <a href="{{ path('app_muscles_index') }}" style="font-size: 20px; color: blue; text-decoration: none">
            Muscles
        </a>
        <a href="{{ path('app_exercises_index') }}" style="font-size: 20px; color: blue; text-decoration: none">
            Exercises
        </a>
        <a href="{{ path('app_exercises_muscles_index') }}" style="font-size: 20px; color: blue; text-decoration: none">
            Exercises Muscles
        </a>
        <a href="{{ path('app_exercises_variants_index') }}" style="font-size: 20px; color: blue; text-decoration: none">
            Exercises Variants
        </a>
    </nav>
    {% endif %}
        {% block body %}{% endblock %}
    </body>
</html>
