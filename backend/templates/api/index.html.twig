{% extends 'base.html.twig' %}

{% block title %}API Endpoints Documentation{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #e8e8e8; padding: 4px 8px; border-radius: 4px; font-weight: bold; color: #d63384; }
    </style>

    <div class="example-wrapper">
        <h1>Home Page</h1>
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Return</th>
                <th>URL endpoint</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Access to Muscle Groups</td>
                <td><code>/api/muscle_groups</code> (GET)</td>
            </tr>
            <tr>
                <td>Exercises (All)</td>
                <td><code>/api/exercises</code> (GET)</td>
            </tr>
            <tr>
                <td>Exercises by Muscle Group</td>
                <td><code>/api/exercises?muscle_group_id=X</code> (GET)</td>
            </tr>
            <tr>
                <td>Create a Workout</td>
                <td><code>/api/workouts</code> (POST)</td>
            </tr>
            </tbody>
        </table>

        <h1>Calendar Page</h1>
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Return</th>
                <th>URL endpoint</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Workouts done by date</td>
                <td><code>/api/workouts?date=YYYY-MM-DD</code> (GET)</td>
            </tr>
            <tr>
                <td>Details of a single workout</td>
                <td><code>/api/workouts/{id}</code> (GET)</td>
            </tr>
            <tr>
                <td>Update a workout</td>
                <td><code>/api/workouts/{id}</code> (PUT)</td>
            </tr>
            <tr>
                <td>Delete a Workout</td>
                <td><code>/api/workouts/{id}</code> (DELETE)</td>
            </tr>
            </tbody>
        </table>

        <h1>Progress Page</h1>
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Return</th>
                <th>URL endpoint</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Filter by exercise and time amount</td>
                <td><code>/api/workouts?exercise_id=X&from=YYYY-MM-DD&to=YYYY-MM-DD</code> (GET)</td>
            </tr>
            </tbody>
        </table>

        <h1>Profile Page</h1>
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Return</th>
                <th>URL endpoint</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Profile Info</td>
                <td><code>/api/profile</code> (GET)</td>
            </tr>
            <tr>
                <td>Edit Profile</td>
                <td><code>/api/profile</code> (PUT)</td>
            </tr>
            <tr>
                <td>Delete Profile</td>
                <td><code>/api/profile</code> (DELETE)</td>
            </tr>
            </tbody>
        </table>

        <h1>Auth (Login & Register)</h1>
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Return</th>
                <th>URL endpoint</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Login (Get Token)</td>
                <td><code>/api/login_check</code> (POST)</td>
            </tr>
            <tr>
                <td>Register</td>
                <td><code>/api/register</code> (POST)</td>
            </tr>
            </tbody>
        </table>
    </div>
{% endblock %}
