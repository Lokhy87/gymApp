{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
    <h1>Edit User: {{ user.name }}</h1>

    <form method="POST" class="mt-4">
        <div class="mb-3">
            <label for="name" class="form-label">Full Name</label>
            <input type="text" id="name" name="name" class="form-control" value="{{ user.name }}" required>
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-control" value="{{ user.email }}" required>
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" id="location" name="location" class="form-control" value="{{ user.location }}">
        </div>

        <div class="mb-3">
            <label for="roles" class="form-label">User Roles (Hold Ctrl/Cmd to select multiple)</label>
            <select id="roles" name="roles[]" class="form-select" multiple size="2">
                <option value="ROLE_USER" {% if 'ROLE_USER' in user.roles %}selected{% endif %}>User</option>
                <option value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}selected{% endif %}>Administrator</option>
            </select>
        </div>

        <div class="mt-4 d-flex gap-3">
            <button type="submit" class="btn">Save Changes</button>
            <a href="{{ path('admin_index') }}" class="btn style-secondary">Cancel</a>
        </div>
    </form>
{% endblock %}
