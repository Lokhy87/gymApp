{% extends 'base.html.twig' %}

{% block title %}WorkSplit index{% endblock %}

{% block body %}
    <h1>WorkSplit index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for work_split in work_splits %}
            <tr>
                <td>{{ work_split.id }}</td>
                <td>{{ work_split.name }}</td>
                <td>{{ work_split.description }}</td>
                <td>
                    <a href="{{ path('app_work_split_show', {'id': work_split.id}) }}">show</a>
                    <a href="{{ path('app_work_split_edit', {'id': work_split.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_work_split_new') }}">Create new</a>
{% endblock %}
