{% extends 'base.html.twig' %}

{% block title %}MuscleGroups index{% endblock %}

{% block body %}
    <h1>MuscleGroups index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Image</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for muscle_group in muscle_groups %}
            <tr>
                <td>{{ muscle_group.id }}</td>
                <td>{{ muscle_group.name }}</td>
                <td>{{ muscle_group.image }}</td>
                <td>
                    <a href="{{ path('app_muscle_groups_show', {'id': muscle_group.id}) }}">show</a>
                    <a href="{{ path('app_muscle_groups_edit', {'id': muscle_group.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_muscle_groups_new') }}">Create new</a>
{% endblock %}
