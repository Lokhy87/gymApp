{% extends 'base.html.twig' %}

{% block title %}TrainingGoal index{% endblock %}

{% block body %}
    <h1>TrainingGoal index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for training_goal in training_goals %}
            <tr>
                <td>{{ training_goal.id }}</td>
                <td>{{ training_goal.name }}</td>
                <td>{{ training_goal.description }}</td>
                <td>
                    <a href="{{ path('app_training_goal_show', {'id': training_goal.id}) }}" class="btn">show</a>
                    <a href="{{ path('app_training_goal_edit', {'id': training_goal.id}) }}" class="btn">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_training_goal_new') }}" class="btn">Create new</a>
{% endblock %}
