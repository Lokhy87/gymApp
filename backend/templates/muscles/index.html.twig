{% extends 'base.html.twig' %}

{% block title %}Muscles index{% endblock %}

{% block body %}
    <h1>Muscles index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Image</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for muscle in muscles %}
            <tr>
                <td>{{ muscle.id }}</td>
                <td>{{ muscle.name }}</td>
                <td>{{ muscle.image }}</td>
                <td>
                    <a href="{{ path('app_muscles_show', {'id': muscle.id}) }}" class="btn">show</a>
                    <a href="{{ path('app_muscles_edit', {'id': muscle.id}) }}" class="btn">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_muscles_new') }}" class="btn">Create new</a>
{% endblock %}
